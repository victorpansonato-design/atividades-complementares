{
   "$schema": "https://openapi.vercel.sh/vercel.json",
   "framework": "vite",
   "installCommand": "npm ci",
   "buildCommand": "npm run build",
   "outputDirectory": "build",
   "redirects": [{ "source": "/", "destination": "/atividades-complementares/", "permanent": false }],
   "rewrites": [
      { "source": "/atividades-complementares/assets/:file*", "destination": "/assets/:file*" },
      { "source": "/atividades-complementares/regulamento/:file*", "destination": "/regulamento/:file*" },
      { "source": "/atividades-complementares/icone_header.png", "destination": "/icone_header.png" },
      { "source": "/atividades-complementares", "destination": "/index.html" },
      { "source": "/atividades-complementares/:path*", "destination": "/index.html" }
   ],
   "headers": [
      {
         "source": "/assets/(.*)",
         "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
   ]
}
