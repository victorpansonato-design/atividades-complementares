# Crie um arquivo .env.local para desenvolvimento local
# Crie um arquivo .env.production para fazer build de produção
VITE_BASE_URL=/atividades-complementares/

# Camada de dados. Neste protótipo só existe o adapter "mock" (nenhuma chamada de rede).
# O adapter real será criado com contratos revisados pelo TI.
VITE_DATA_MODE=mock

# Destino do botão "Voltar ao portal". Vazio = entrada local de demonstração (/entrada-portal).
# Não há URL de produção confirmada; configure apenas quando o TI fornecer o endereço.
VITE_PORTAL_RETURN_URL=

# Catálogo de Bagagens no AVA (cursos gratuitos que valem 15h).
VITE_BAGAGENS_URL=https://ava.anchieta.br/d2l/le/discovery/view/

# Botão do TanStack Query Devtools no `npm run dev` (padrão: desligado).
VITE_QUERY_DEVTOOLS=false

# Exibe o painel discreto de demonstração (cenários, decisões simuladas, reset).
VITE_DEMO_TOOLS=true

# Referências do template para o futuro adapter real. Não são usadas no modo mock.
VITE_API_URL=/atividades-complementares/api/v1/
# aluno (a confirmar pelo TI)
# VITE_LOGIN_URL=/Aol_Responsivo_Redirect/auth/login/index.php
